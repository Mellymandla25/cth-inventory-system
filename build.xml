<?xml version="1.0" encoding="UTF-8"?>
<project name="CTH_Inventory_System" default="build" basedir=".">
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="dist.dir" value="dist"/>
    <property name="lib.dir" value="libs"/>
    
    <target name="init">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>
    
    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${build.dir}" includeantruntime="false">
            <classpath>
                <fileset dir="${lib.dir}">
                    <include name="*.jar"/>
                </fileset>
            </classpath>
        </javac>
    </target>
    
    <target name="jar" depends="compile">
        <jar destfile="${dist.dir}/CTH_Inventory_System.jar" basedir="${build.dir}">
            <manifest>
                <attribute name="Main-Class" value="com.cth.Main"/>
                <attribute name="Class-Path" value="${lib.dir}/sqlite-jdbc-3.42.0.0.jar ${lib.dir}/itext7-core-7.2.3.jar"/>
            </manifest>
            <zipfileset dir="${src.dir}" includes="**/*.properties"/>
        </jar>
    </target>
    
    <target name="build" depends="jar">
        <copy todir="${dist.dir}">
            <fileset dir="${lib.dir}" includes="*.jar"/>
        </copy>
        <copy todir="${dist.dir}" file="resources/logo.png" failonerror="false"/>
    </target>
    
    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
</project>